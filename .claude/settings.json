{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|resume",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"${CLAUDE_PROJECT_DIR}/tools/entry_state.py\" --hook",
            "statusMessage": "Reading the entry state",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
